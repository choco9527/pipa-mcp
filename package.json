{
  "name": "@choco9527/pipa-cli",
  "version": "0.1.2",
  "description": "PIPA tasks and notes for people and agents: standalone CLI and MCP in one package with one shared login.",
  "type": "module",
  "bin": { "pipa": "src/bin.mjs" },
  "files": ["src", "skills", "README.md", "LICENSE", "npm-shrinkwrap.json"],
  "engines": { "node": ">=22" },
