  "scripts": { "test": "node --test test/*.test.mjs", "check": "node --check src/bin.mjs && node --check src/index.mjs", "pack:check": "npm pack --dry-run" },
  "repository": { "type": "git", "url": "git+https://github.com/choco9527/pipa-mcp.git" },
  "license": "MIT",
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "proper-lockfile": "4.1.2"
  }
}
